layout {

    focus-ring {
        active-color   "#d2c5b2"
        inactive-color "#141312"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#d2c5b2"
        inactive-color "#141312"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#d2c5b2"
        inactive-color "#9b8f7e"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#d2c5b280"
    }
}

recent-windows {
    highlight {
        active-color "#d2c5b2"
        urgent-color "#ffb4ab"
    }
}

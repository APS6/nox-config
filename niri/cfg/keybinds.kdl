// ────────────── Keybindings ──────────────
// https://github.com/YaLTeR/niri/wiki/Configuration:-Key-Bindings

binds {
    MOD+SHIFT+ESCAPE                    allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    // ─── Applications ───
    MOD+RETURN                          hotkey-overlay-title="Open Terminal: ghostty" { spawn "ghostty"; }
    MOD+SPACE                           hotkey-overlay-title="Open App Launcher" { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    MOD+C                               hotkey-overlay-title="Open Clipboard" { spawn "noctalia" "msg" "panel-toggle" "clipboard"; }
    MOD+SHIFT+E                         hotkey-overlay-title="Open emojis" { spawn "noctalia" "msg" "panel-toggle" "launcher" "/emo"; }
    MOD+SHIFT+T                         hotkey-overlay-title="Wallpaper Picker" { spawn "noctalia" "msg" "panel-toggle" "wallpaper"; }
    MOD+ALT+T                           hotkey-overlay-title="Wallpaper toggle" { spawn-sh "noctalia msg wallpaper-next"; }
    MOD+B                               hotkey-overlay-title="Open Browser: zen" { spawn "zen-browser"; }
    MOD+Z                               hotkey-overlay-title="Open Editor: zed" { spawn "zeditor"; }
    MOD+a                               hotkey-overlay-title="Launch Antigravity" { spawn "/home/aps/Applications/Antigravity/Antigravity-x64/antigravity"; }
    MOD+T                               hotkey-overlay-title="Open System Monitor: btop" { spawn "ghostty" "-e" "btop"; }
    MOD+M                               hotkey-overlay-title="Open YouTube Music" { spawn "uwsm" "app" "--" "brave-origin" "--app=https://music.youtube.com"; }
    MOD+SLASH                           hotkey-overlay-title="Open Bitwarden" { spawn "bitwarden-desktop"; }
    MOD+CTRL+I                          hotkey-overlay-title="Toggle Auto-lock" { spawn "noctalia" "msg" "caffeine-toggle"; }

    MOD+V                               hotkey-overlay-title="Voice Dictation" { spawn "voice-dictate"; }

    MOD+E                             hotkey-overlay-title="File Manager: Nautilus" { spawn-sh "nautilus"; }

    // ─── Audio Controls ───
    XF86AudioRaiseVolume                allow-when-locked=true { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume                allow-when-locked=true { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute                       allow-when-locked=true { spawn-sh "noctalia msg volume-mute"; }
    XF86AudioMicMute                    allow-when-locked=true { spawn-sh "noctalia msg mic-mute"; }
    XF86AudioNext                       allow-when-locked=true { spawn-sh "noctalia msg media next"; }
    XF86AudioPause                      allow-when-locked=true { spawn-sh "noctalia msg media toggle"; }
    XF86AudioPlay                       allow-when-locked=true { spawn-sh "noctalia msg media toggle"; }
    XF86AudioPrev                       allow-when-locked=true { spawn-sh "noctalia msg media previous"; }

    // ─── Brightness Controls ───
    XF86MonBrightnessUp                 allow-when-locked=true { spawn-sh "noctalia msg brightness-up"; }
    XF86MonBrightnessDown               allow-when-locked=true { spawn-sh "noctalia msg brightness-down"; }

    // ─── Window Movement and Focus ───
    MOD+W                               { close-window; }

    MOD+LEFT                            { focus-column-left; }
    MOD+H                               { focus-column-left; }
    MOD+RIGHT                           { focus-column-right; }
    MOD+L                               { focus-column-right; }
    MOD+UP                              { focus-window-up; }
    MOD+K                               { focus-workspace-down; }
    MOD+DOWN                            { focus-window-down; }
    MOD+J                               { focus-workspace-up; }

    MOD+CTRL+LEFT                       { move-column-left; }
    MOD+CTRL+H                          { move-column-left; }
    MOD+CTRL+RIGHT                      { move-column-right; }
    MOD+CTRL+L                          { move-column-right; }
    MOD+CTRL+UP                         { move-window-up; }
    MOD+CTRL+K                          { move-window-up; }
    MOD+CTRL+DOWN                       { move-window-down; }
    MOD+CTRL+J                          { move-window-down; }

    MOD+HOME                            { focus-column-first; }
    MOD+END                             { focus-column-last; }
    MOD+CTRL+HOME                       { move-column-to-first; }
    MOD+CTRL+END                        { move-column-to-last; }

    MOD+SHIFT+LEFT                      { focus-monitor-left; }
    MOD+SHIFT+RIGHT                     { focus-monitor-right; }
    MOD+SHIFT+UP                        { focus-monitor-up; }
    MOD+SHIFT+DOWN                      { focus-monitor-down; }

    MOD+SHIFT+CTRL+LEFT                 { move-column-to-monitor-left; }
    MOD+SHIFT+CTRL+RIGHT                { move-column-to-monitor-right; }
    MOD+SHIFT+CTRL+UP                   { move-column-to-monitor-up; }
    MOD+SHIFT+CTRL+DOWN                 { move-column-to-monitor-down; }

    // ─── Workspace Switching ───
    MOD+SHIFT+WHEELSCROLLDOWN           cooldown-ms=150 { focus-workspace-down; }
    MOD+SHIFT+WHEELSCROLLUP             cooldown-ms=150 { focus-workspace-up; }
    MOD+CTRL+SHIFT+WHEELSCROLLDOWN      cooldown-ms=150 { move-column-to-workspace-down; }
    MOD+CTRL+SHIFT+WHEELSCROLLUP        cooldown-ms=150 { move-column-to-workspace-up; }
    MOD+Page_Up                         { focus-workspace-up; }
    MOD+Page_Down                       { focus-workspace-down; }

    MOD+WHEELSCROLLRIGHT                { focus-column-right; }
    MOD+WHEELSCROLLLEFT                 { focus-column-left; }
    MOD+CTRL+WHEELSCROLLRIGHT           { move-column-right; }
    MOD+CTRL+WHEELSCROLLLEFT            { move-column-left; }

    MOD+WHEELSCROLLDOWN                 { focus-column-right; }
    MOD+WHEELSCROLLUP                   { focus-column-left; }
    MOD+CTRL+WHEELSCROLLDOWN            { move-column-right; }
    MOD+CTRL+WHEELSCROLLUP              { move-column-left; }

    MOD+1                               { focus-workspace 1; }
    MOD+2                               { focus-workspace 2; }
    MOD+3                               { focus-workspace 3; }
    MOD+4                               { focus-workspace 4; }
    MOD+5                               { focus-workspace 5; }
    MOD+6                               { focus-workspace 6; }
    MOD+7                               { focus-workspace 7; }
    MOD+8                               { focus-workspace 8; }
    MOD+9                               { focus-workspace 9; }

    MOD+SHIFT+1                         { move-column-to-workspace 1; }
    MOD+SHIFT+2                         { move-column-to-workspace 2; }
    MOD+SHIFT+3                         { move-column-to-workspace 3; }
    MOD+SHIFT+4                         { move-column-to-workspace 4; }
    MOD+SHIFT+5                         { move-column-to-workspace 5; }
    MOD+SHIFT+6                         { move-column-to-workspace 6; }
    MOD+SHIFT+7                         { move-column-to-workspace 7; }
    MOD+SHIFT+8                         { move-column-to-workspace 8; }
    MOD+SHIFT+9                         { move-column-to-workspace 9; }

    MOD+TAB                             { focus-monitor-next; }
    Alt+Tab                             { spawn-sh "noctalia msg window-switcher"; }

    // ─── Layout Controls ───
    MOD+F                          { maximize-column; }
    MOD+CTRL+C                          { center-visible-columns; }
    MOD+MINUS                           { set-column-width "-10%"; }
    MOD+EQUAL                           { set-column-width "+10%"; }
    MOD+SHIFT+MINUS                     { set-window-height "-10%"; }
    MOD+SHIFT+EQUAL                     { set-window-height "+10%"; }

    // ─── Modes ───
    MOD+ALT+V                           hotkey-overlay-title="Toggle Floating Window" { toggle-window-floating; }
    MOD+SHIFT+F                               { fullscreen-window; }
    MOD+Q                               { toggle-column-tabbed-display; }
    MOD+SHIFT+SPACE                     allow-when-locked=true { spawn-sh "noctalia msg bar-toggle"; }

    // ─── Screenshots ───
    // click-drag region (already works)
    PRINT                               { spawn-sh "grim -g \"$(slurp)\" - | satty --filename -"; }

    // focused window (instant, no mouse needed)
    SHIFT+PRINT                         { spawn-sh "~/.config/niri/scripts/alt-print.sh"; }

    // click a monitor/output
    CTRL+PRINT                          { spawn-sh "grim -g \"$(slurp -o)\" - | satty --filename -"; }

    // screen mirroring
    Mod+P repeat=false { spawn-sh "wl-mirror $(niri msg --json focused-output | jq -r .name)"; }

    // ─── Noctalia ───
    MOD+ESCAPE                          hotkey-overlay-title="Power Menu" { spawn "noctalia" "msg" "panel-toggle" "session"; }
    Mod+S { spawn "noctalia" "msg" "panel-toggle" "control-center"; }
    Mod+Comma { spawn "noctalia" "msg" "settings-toggle"; }

    // ─── Exit / Power ───
    CTRL+ALT+DELETE                     { quit; } // Also quits Niri
    MOD+SHIFT+P                         { power-off-monitors; } // Turn off screens (useful for OLED or privacy)
    MOD+O                               repeat=false { toggle-overview; }
}
